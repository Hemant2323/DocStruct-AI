# ---------------------------------------------------------------------------
# DocStruct AI — example environment configuration
#
# Copy this file to `.env` and adjust the values:
#     cp .env.example .env
#
# `.env` is gitignored and MUST NEVER be committed.
# This file documents variable NAMES only — never put a real secret here.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_NAME="DocStruct AI"

# development | test | production
# In production the interactive API docs (/docs, /redoc) are disabled.
APP_ENV=development

DEBUG=false

# Prefix for every API route. The frontend must be configured to match.
API_PREFIX=/api

# --- Server ----------------------------------------------------------------
HOST=127.0.0.1
PORT=8000

# --- Logging ---------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# --- Database --------------------------------------------------------------
# PostgreSQL is the production target. The URL contains credentials, so it is a
# secret — it lives here, never in alembic.ini or any committed file.
#
#   DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/docstruct
#
# SQLite is the zero-setup default so the project runs on a clean machine with no
# database server installed. Leave this commented out to use it.
# DATABASE_URL=sqlite+aiosqlite:///./docstruct.db

# Log every SQL statement. Useful when debugging, very noisy otherwise.
DATABASE_ECHO=false

# --- File storage ----------------------------------------------------------
# Where uploaded documents are stored. Gitignored — user files never enter git.
STORAGE_DIR=./storage

# Upload ceiling in megabytes (1–500). Enforced before a file is buffered.
MAX_UPLOAD_SIZE_MB=25

# --- CORS ------------------------------------------------------------------
# Comma-separated browser origins allowed to call this API.
# Must include the frontend dev server. Never use "*" — that lets any website
# on the internet call the API with the user's credentials.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- AI --------------------------------------------------------------------
# Your Anthropic API key. REAL VALUE GOES IN `.env` ONLY, NEVER IN THIS FILE.
# Get one at https://console.anthropic.com/
#
# The key is used server-side only. It is never sent to the browser, never returned
# by any endpoint (not even partially), and never written to a log.
#
# Leaving it empty is fine: the app runs normally and the AI features report that
# they are not configured, instead of failing in a confusing way.
ANTHROPIC_API_KEY=

ANTHROPIC_MODEL=claude-opus-5

# Where to send API requests. Leave empty (or omit) to use Anthropic directly.
#
# Set this to point the same Anthropic SDK at an Anthropic-compatible provider —
# useful during development. Only the endpoint changes; the provider code, the
# LLMProvider abstraction and all analysis logic stay exactly the same.
#
#   ANTHROPIC_BASE_URL=https://api.freemodel.dev/v1
#
# When using a compatible provider, set ANTHROPIC_MODEL to a model name that
# provider recognises (for example `auto` for automatic routing).
#
# NOTE: your documents are sent to whichever endpoint this points at. Point it only
# at a provider you are willing to share document contents with.
ANTHROPIC_BASE_URL=

# --- Alternative provider: NVIDIA NIM (OpenAI-compatible) ------------------
# Which provider `AI_PROVIDER` selects. Defaults to "claude" so existing behaviour
# is unchanged unless this is set explicitly.
#
#   AI_PROVIDER=claude   (default — uses ANTHROPIC_API_KEY etc. above)
#   AI_PROVIDER=nvidia   (uses the NVIDIA_* variables below instead)
#   AI_PROVIDER=gemini   (uses the GEMINI_* variables below instead)
AI_PROVIDER=claude

# Your NVIDIA NIM API key. REAL VALUE GOES IN `.env` ONLY, NEVER IN THIS FILE.
# Only read when AI_PROVIDER=nvidia. Used server-side only — never sent to the
# browser, never returned by any endpoint, never written to a log.
NVIDIA_API_KEY=

NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=deepseek-ai/deepseek-v4-flash-0731

# --- Alternative provider: Google Gemini ------------------------------------
# Your Gemini API key. REAL VALUE GOES IN `.env` ONLY, NEVER IN THIS FILE.
# Get one at https://aistudio.google.com/apikey
#
# Only read when AI_PROVIDER=gemini. Used server-side only — never sent to the
# browser, never returned by any endpoint, never written to a log.
GEMINI_API_KEY=

GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.5-flash

# Embedding model used for retrieval (/ask) — separate from GEMINI_MODEL above, which is
# the generation model. A chat model name is not valid for the embeddings endpoint.
GEMINI_EMBEDDING_MODEL=gemini-embedding-2-preview

# Ceiling on the model's reply. Summaries and explanations are short.
AI_MAX_OUTPUT_TOKENS=8000

# Thinking depth and overall token spend: low | medium | high | xhigh | max
AI_EFFORT=high

# Seconds to wait for the model. Large documents legitimately take a while.
AI_TIMEOUT_SECONDS=300

# Retries for transient failures (rate limits, 5xx, connection errors).
AI_MAX_RETRIES=2

# Cache the document prefix so the 2nd and 3rd analysis of the same document cost less.
AI_PROMPT_CACHING=true

# Largest context to send, in estimated tokens. Claude Opus 5 has a 1M window; this
# leaves headroom for the prompt, thinking and the reply.
AI_MAX_CONTEXT_TOKENS=600000

# --- Optional AI context optimization --------------------------------------
# Off by default and never automatic — the user opts in per request.
#
# Below this size a document is not worth optimizing, and the option is not offered.
AI_OPTIMIZATION_MIN_TOKENS=20000

# How much of the document an optimized context may use (0.5 = about half).
AI_OPTIMIZATION_TARGET_RATIO=0.5

# --- Windowed conversion extraction -----------------------------------------
# Above this many estimated tokens of extracted content, a conversion reads the document
# in windows instead of one call, so a long document cannot lose records to the reply's
# own token ceiling. Below it, conversion behaves exactly as it always has.
CONVERSION_CHUNK_WINDOW_TOKENS=40000

# Floor on an adaptively sized window. The first window of a long document is planned at
# this size and its records are what the remaining windows are sized from, so it must be
# small enough to be safe for a densely packed document.
CONVERSION_CHUNK_MIN_WINDOW_TOKENS=2000

# How many window extractions run at once. Kept low on purpose: the provider's retry
# budget is per request, so concurrency multiplies the requests arriving inside one
# rate-limit window.
CONVERSION_CHUNK_CONCURRENCY=3

# Set to false to force every conversion back onto the single-call path.
CONVERSION_CHUNKING_ENABLED=true
