# Frontend environment variables.
# Copy to `.env.local` (gitignored) to override. Only names prefixed with VITE_ are
# exposed to the browser — never put a secret in any of them, because everything here
# is bundled into publicly readable JavaScript.

# Base URL of the backend API. Leave empty to use same-origin relative requests, which
# the Vite dev-server proxy forwards to the backend (see vite.config.ts).
VITE_API_BASE_URL=
